datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  Viewer
  Member
  Lead
  Admin
}

enum ItemType {
  incident
  customer_issue
  payment
  compliance
  task
}

enum ItemPriority {
  low
  medium
  high
  urgent
}

enum ItemStatus {
  Open
  In_Progress
  Awaiting_Approval
  Resolved
  Closed
}

enum OutboxStatus {
  pending
  processing
  completed
  failed
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  name         String
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  memberships  Membership[]
  createdItems WorkItem[]   @relation("ItemCreator")
  assignedItems WorkItem[]  @relation("ItemAssignee")
  activityLogs ActivityEvent[]
  comments     Comment[]
  idempotencyKeys IdempotencyKey[]

  @@map("users")
}

model Team {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())

  memberships Membership[]
  workItems   WorkItem[]

  @@map("teams")
}

model Membership {
  id        String   @id @default(uuid())
  userId    String
  teamId    String
  role      Role     @default(Member)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([userId])
  @@index([teamId])
  @@map("memberships")
}

model WorkItem {
  id          String       @id @default(uuid())
  title       String
  description String
  type        ItemType
  priority    ItemPriority @default(medium)
  status      ItemStatus   @default(Open)
  teamId      String
  assigneeId  String?
  createdById String
  dueDate     DateTime?
  version     Int          @default(1)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  team       Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  creator    User         @relation("ItemCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignee   User?        @relation("ItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  activities ActivityEvent[]
  comments   Comment[]

  @@index([teamId, status])
  @@index([assigneeId, status])
  @@index([priority, status])
  @@index([createdAt])
  @@map("work_items")
}

model ActivityEvent {
  id         String   @id @default(uuid())
  workItemId String
  actorId    String
  action     String   // created, claimed, assigned, priority_changed, status_changed, comment_added
  fromValue  String?
  toValue    String?
  metadata   String?  // JSON stringified details
  createdAt  DateTime @default(now())

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  actor    User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([workItemId, createdAt])
  @@map("activity_events")
}

model Comment {
  id         String   @id @default(uuid())
  workItemId String
  authorId   String
  content    String
  createdAt  DateTime @default(now())

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([workItemId, createdAt])
  @@map("comments")
}

model IdempotencyKey {
  key          String   @id
  userId       String
  endpoint     String
  statusCode   Int
  responseBody String   // JSON stringified response
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([key, userId])
  @@map("idempotency_keys")
}

model OutboxJob {
  id          String       @id @default(uuid())
  jobType     String       // e.g. "notify_new_assignee", "notify_status_transition"
  payload     String       // JSON stringified payload
  status      OutboxStatus @default(pending)
  attempts    Int          @default(0)
  maxAttempts Int          @default(5)
  nextRunAt   DateTime     @default(now())
  lastError   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, nextRunAt])
  @@map("outbox_jobs")
}
